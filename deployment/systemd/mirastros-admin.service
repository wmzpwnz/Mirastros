[Unit]
Description=Mirastros Admin Panel
After=network.target

[Service]
Type=simple
User=mirastros
Group=mirastros
WorkingDirectory=/var/www/mirastros/admin
Environment="NODE_ENV=production"
Environment="PORT=3001"
Environment="NEXT_PUBLIC_API_URL=https://www.mirastros.com/api"
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=append:/var/log/mirastros/admin.log
StandardError=append:/var/log/mirastros/admin-error.log

[Install]
WantedBy=multi-user.target
