[Unit]
Description=Mirastros web
After=network-online.target mirastros-api.service

[Service]
User=mirastros
Group=mirastros
WorkingDirectory=/srv/mirastros/current/web
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/srv/mirastros/current/bin/node apps/web/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
