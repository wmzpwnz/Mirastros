                      const ruNames: Record<string, string> = {
                        sun: 'Солнце', moon: 'Луна', mercury: 'Меркурий', venus: 'Венера', mars: 'Марс',
                        jupiter: 'Юпитер', saturn: 'Сатурн', uranus: 'Уран', neptune: 'Нептун', pluto: 'Плутон',
                      };
                      const planetName = ruNames[dominant.planet.toLowerCase()] || dominant.planet;
                      const signName = ZODIAC_SIGNS[ZODIAC_KEYS[dominant.signIndex] || 'aries']?.name || '—';
                      return `${planetName} в ${signName}`;
                    })()}
                  </div>
                </div>
              )}

              {/* Модальности - занимает всю оставшуюся ширину */}
