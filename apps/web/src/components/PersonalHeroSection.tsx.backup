                  <p className="hero-kicker text-silver/50 text-[10px] uppercase tracking-widest text-center mb-1">
                    Лунное влияние
                  </p>
                  <p
                    className={`hero-body text-silver/80 text-sm leading-relaxed text-center italic ${
                      isCompact ? 'line-clamp-2' : ''
