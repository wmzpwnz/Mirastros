                <div className="text-[10px] text-white mb-2 uppercase tracking-wider font-bold">Модальности</div>
                <div className="grid grid-cols-3 gap-2 flex-1 items-center">
                  <div className="text-center">
                    <div className="text-[9px] text-white mb-0.5">Кард.</div>
                    <div className="text-xs font-semibold text-white">{modalities.cardinal}%</div>
                  </div>
                  <div className="text-center">
                    <div className="text-[9px] text-white mb-0.5">Фикс.</div>
                    <div className="text-xs font-semibold text-white">{modalities.fixed}%</div>
                  </div>
                  <div className="text-center">
                    <div className="text-[9px] text-white mb-0.5">Мутаб.</div>
                    <div className="text-xs font-semibold text-white">{modalities.mutable}%</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>

      <button
        onClick={onViewFull}
        className="hero-panel-footer mira-button text-xs sm:text-sm mt-auto"
      >
        Полный анализ →
      </button>
    </div>
  );
};

