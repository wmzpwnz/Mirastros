        </div>

        {/* Планеты */}
        {!isUltra ? (
          <div className="hero-natal-planets hero-natal-planets-panel grid grid-cols-2 gap-x-3 gap-y-1.5 mb-2 bg-white/5 p-2.5 rounded-lg border border-white/5">
            {mainPlanets.map(({ name, planet, label }) => {
              const signKey = ZODIAC_KEYS[signToNum(planet.sign)] || 'aries';
              const signName = ZODIAC_SIGNS[signKey]?.name;
              const signShort = signName ? signName.substring(0, 3) : planet.sign.substring(0, 3);
              const isRetrograde = planet.retrograde;
              return (
                <div key={name} className="hero-natal-planet-row flex items-center justify-between text-xs">
                  <span className="hero-natal-planet-label text-silver/70 flex items-center gap-1">
                    {PLANET_EMOJI[name] || '⭐'} {label}
                    {isRetrograde && <span className="text-purple-400 text-[10px]">R</span>}
                  </span>
                  <span className="hero-natal-planet-value text-white font-medium text-xs">
                    {signShort} {Math.round(planet.degree)}°
