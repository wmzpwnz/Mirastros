                </div>
              );
            })}
            {ascendant && (
              <div className="hero-natal-planet-row flex items-center justify-between text-xs col-span-2 pt-1 border-t border-white/10">
                <span className="hero-natal-planet-label text-silver/70 flex items-center gap-1">
                  ⬆️ Асцендент
                  {ascendantRuler && (
                    <span className="text-mirastros-gold text-[10px] ml-1">({ascendantRuler.label})</span>
                  )}
                </span>
                <span className="hero-natal-planet-value text-white font-medium text-xs">
                  {(() => {
                    const signKey = ZODIAC_KEYS[signToNum(ascendant.sign)] || 'aries';
                    const name = ZODIAC_SIGNS[signKey]?.name;
                    return `${name ? name.substring(0, 3) : ascendant.sign.substring(0, 3)} ${Math.round(ascendant.degree)}°`;
                  })()}
                </span>
              </div>
            )}
          </div>
        ) : (
          <p className="hero-body hero-natal-summary text-silver/70 text-xs mb-3">
            ☀️ {Math.round(sun.degree)}° • 🌙 {Math.round(moon.degree)}° • ⬆️{' '}
            {ascendant ? `${Math.round(ascendant.degree)}°` : '—'}
          </p>
        )}

        {/* Новые блоки: модальности / доминанта / ретроградные */}
        {!isUltra && (
          <div className="hero-natal-insights mb-2 w-full">
            {/* Все три блока в одном ряду с одинаковой высотой */}
