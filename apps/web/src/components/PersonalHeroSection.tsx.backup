// Cache helpers
const CACHE_PREFIX = 'mira_hero_cache_';
const CACHE_DURATION = 60 * 60 * 1000; // 1 hour
const MATRIX_UPDATED_EVENT = 'mira:matrix-updated';
const normalizeBirthDate = (value?: string | null) =>
  (value || '').split('T')[0];
const formatIsoDate = (d: Date) => d.toISOString().slice(0, 10);
const weekStartIso = (d: Date) => {
  const copy = new Date(d);
  copy.setDate(copy.getDate() - ((copy.getDay() + 6) % 7));
  return formatIsoDate(copy);
};
const monthIso = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const sanitizePlain = (value: string) =>
  value
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]*)`/g, '$1')
    .replace(/[*_~#[\]()]/g, ' ')
    .replace(/\s{2,}/g, ' ')
    .trim();

const getCachedData = <T,>(key: string): T | null => {
  if (typeof window === 'undefined') return null;
  try {
    const item = sessionStorage.getItem(CACHE_PREFIX + key);
    if (!item) return null;
    const { data, timestamp } = JSON.parse(item);
    if (Date.now() - timestamp > CACHE_DURATION) {
      sessionStorage.removeItem(CACHE_PREFIX + key);
      return null;
    }
    return data;
  } catch {
    return null;
  }
};

const setCachedData = (key: string, data: any) => {
  if (typeof window === 'undefined') return;
  try {
    sessionStorage.setItem(
      CACHE_PREFIX + key,
      JSON.stringify({
        data,
        timestamp: Date.now(),
      })
    );
  } catch (e) {
    console.warn('Cache quota exceeded');
  }
};

export const PersonalHeroSection: React.FC<PersonalHeroSectionProps> = ({
  user,
}) => {
  const router = useRouter();
  const density = useHeroDensity();
  const [natalChart, setNatalChart] = useState<NatalChart | null>(null);
  const [horoscopes, setHoroscopes] = useState<{
    daily: Horoscope | null;
    weekly: Horoscope | null;
    monthly: Horoscope | null;
  }>({
    daily: null,
    weekly: null,
    monthly: null,
  });
  const [destinyMatrix, setDestinyMatrix] = useState<DestinyMatrix | null>(
    null
  );
  const [loading, setLoading] = useState(true);
  const [ratingsLoading, setRatingsLoading] = useState(false);
  const [matrixLoading, setMatrixLoading] = useState(false);
  const [mousePosition, setMousePosition] = useState({ x: 0, y: 0 });

  const zodiacSign = user.zodiacSign?.toLowerCase() || '';
  const zodiacInfo = zodiacSign ? ZODIAC_SIGNS[zodiacSign] : null;
  const normalizedBirthDate = normalizeBirthDate(user.birthDate);
  const hasBirthData = !!(
    user.birthDate &&
    user.birthTime &&
    user.birthLocation
  );
  const isPremium =
    user.subscriptionTier === 'premium' || user.subscriptionTier === 'platinum';

  // Debug logging
  useEffect(() => {
    console.log('PersonalHeroSection - User data:', {
      birthDate: user.birthDate,
      birthTime: user.birthTime,
      birthLocation: user.birthLocation,
      zodiacSign: user.zodiacSign,
      hasBirthData,
      subscriptionTier: user.subscriptionTier,
    });
  }, [user, hasBirthData]);

  useEffect(() => {
    // Register GSAP plugins
    if (typeof window !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
    }

    // Mouse parallax effect
    const handleMouseMove = (e: MouseEvent) => {
      const x = (e.clientX - window.innerWidth / 2) * 0.05;
      const y = (e.clientY - window.innerHeight / 2) * 0.05;
      setMousePosition({ x, y });
    };

    window.addEventListener('mousemove', handleMouseMove);
    return () => window.removeEventListener('mousemove', handleMouseMove);
  }, []);

  useEffect(() => {
    if (!normalizedBirthDate || typeof window === 'undefined') return;

    const onMatrixUpdated = (
      event: Event
    ) => {
      const customEvent = event as CustomEvent<{
        birthDate?: string;
        matrix?: DestinyMatrix | null;
      }>;
      const payload = customEvent.detail;
      if (!payload?.matrix) return;
      const payloadBirthDate = normalizeBirthDate(payload.birthDate);
      if (payloadBirthDate && payloadBirthDate !== normalizedBirthDate) return;

      const matrixKey = `matrix_${normalizedBirthDate}`;
      setDestinyMatrix(payload.matrix);
      setCachedData(matrixKey, payload.matrix);
    };

    window.addEventListener(MATRIX_UPDATED_EVENT, onMatrixUpdated as EventListener);
    return () =>
      window.removeEventListener(MATRIX_UPDATED_EVENT, onMatrixUpdated as EventListener);
  }, [normalizedBirthDate]);

  useEffect(() => {
    const loadData = async () => {
      setLoading(true);

      // Prepare all promises for parallel execution
      const promises: Promise<void>[] = [];

      // Load natal chart (Premium). Don't gate on profile birth data:
      // users may already have a calculated chart stored in DB.
      if (isPremium) {
        const cacheKey = `natal_${user.id || 'curr'}`;
        const cached = getCachedData<NatalChart>(cacheKey);

        if (cached) {
          setNatalChart(cached);
        } else {
          promises.push(
            api
              .getNatalChart()
              .then((chart) => {
                setNatalChart(chart);
                if (chart) setCachedData(cacheKey, chart);
              })
              .catch((err) => console.error('Failed to load natal chart:', err))
          );
        }
      }

      // Load horoscopes
      if (zodiacSign) {
        const now = new Date();
        // Daily
        const dailyKey = `horoscope_daily_${zodiacSign}_${formatIsoDate(now)}`;
        const cachedDaily = getCachedData<Horoscope>(dailyKey);

        if (cachedDaily) {
          setHoroscopes((prev) => ({ ...prev, daily: cachedDaily }));
        } else {
          setRatingsLoading(true);
          promises.push(
            api
              .getHoroscope(zodiacSign, 'daily')
              .then((daily) => {
                setHoroscopes((prev) => ({
                  ...prev,
                  daily: daily
                    ? {
                        ...daily,
                        prediction: sanitizePlain(daily.prediction),
                        plainText: sanitizePlain(daily.plainText || daily.prediction),
                      }
                    : daily,
                }));
                if (daily) setCachedData(dailyKey, daily);
              })
              .catch((err) =>
                console.error('Failed to load daily horoscope:', err)
              )
              .finally(() => setRatingsLoading(false))
          );
        }

        // Weekly & Monthly (Premium)
        if (isPremium) {
          const weeklyKey = `horoscope_weekly_${zodiacSign}_${weekStartIso(now)}`;
          const cachedWeekly = getCachedData<Horoscope>(weeklyKey);

          if (cachedWeekly) {
            setHoroscopes((prev) => ({ ...prev, weekly: cachedWeekly }));
          } else {
            promises.push(
              api
                .getHoroscope(zodiacSign, 'weekly')
                .then((weekly) => {
                  setHoroscopes((prev) => ({ ...prev, weekly }));
                  if (weekly) setCachedData(weeklyKey, weekly);
                })
                .catch((err) =>
                  console.error('Failed to load weekly horoscope:', err)
                )
            );
          }

          const monthlyKey = `horoscope_monthly_${zodiacSign}_${monthIso(now)}`;
          const cachedMonthly = getCachedData<Horoscope>(monthlyKey);

          if (cachedMonthly) {
            setHoroscopes((prev) => ({ ...prev, monthly: cachedMonthly }));
          } else {
            promises.push(
              api
                .getHoroscope(zodiacSign, 'monthly')
                .then((monthly) => {
                  setHoroscopes((prev) => ({ ...prev, monthly }));
                  if (monthly) setCachedData(monthlyKey, monthly);
                })
                .catch((err) =>
                  console.error('Failed to load monthly horoscope:', err)
                )
            );
          }
        }
      }

      // Load destiny matrix
      if (normalizedBirthDate) {
        setMatrixLoading(true);
        const matrixKey = `matrix_${normalizedBirthDate}`;
        const cachedMatrix = getCachedData<DestinyMatrix>(matrixKey);

        if (cachedMatrix) {
          setDestinyMatrix(cachedMatrix);
          setMatrixLoading(false);

          // Cached legacy v1 can hide fresh v2 result from another page.
          if (cachedMatrix.calculation_version === 'v1') {
            promises.push(
              api
                .getDestinyMatrix()
                .then((matrix) => {
                  if (matrix && matrix.calculation_version === 'v2') {
                    setDestinyMatrix(matrix);
                    setCachedData(matrixKey, matrix);
                  }
                })
                .catch((err) => {
                  console.error(
                    '[PersonalHero] Failed to refresh destiny matrix from cache:',
                    err
                  );
                })
            );
          }
        } else {
          promises.push(
            api
              .getDestinyMatrix()
              .then(async (matrix) => {
                if (!matrix && normalizedBirthDate) {
                  try {
                    matrix = await api.calculateDestinyMatrix(normalizedBirthDate);
                  } catch (calcErr: any) {
                    console.error(
                      '[PersonalHero] Failed to calculate destiny matrix:',
                      calcErr
                    );
                  }
                }
                setDestinyMatrix(matrix);
                if (matrix) setCachedData(matrixKey, matrix);
              })
              .catch((err) => {
                console.error(
                  '[PersonalHero] Failed to load destiny matrix:',
                  err
                );
                setDestinyMatrix(null);
              })
              .finally(() => setMatrixLoading(false))
          );
        }
      }

      // Execute all promises in parallel
      try {
        if (promises.length > 0) {
          await Promise.all(promises);
        }
      } finally {
        setLoading(false);
        setRatingsLoading(false);
      }
    };

    loadData();
  }, [user, normalizedBirthDate, hasBirthData, zodiacSign, isPremium]);

  // Tunnel effect animation - same as main Hero section
  useEffect(() => {
    if (typeof window === 'undefined') return;

    const heroBgWrapper = document.querySelector('.personal-hero-bg');
    const heroBgImg = heroBgWrapper?.querySelector('.hero-bg-img');
    const heroOverlay = document.querySelector('.personal-hero-overlay');

    if (!heroBgWrapper || !heroBgImg) return;

    // Create tunnel effect on scroll
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: document.body,
        start: 'top top',
        end: '200vh top',
        scrub: 0.5,
      },
    });

    // Stage 1: Background zooms into tunnel with blur
    tl.to(
      heroBgImg,
      {
        scale: 2.5,
        filter: 'blur(30px)',
        ease: 'power1.in',
        duration: 0.5,
      },
      0
    );

    // Darken overlay as we scroll
    if (heroOverlay) {
      tl.to(
        heroOverlay,
        {
          opacity: 0.95,
          ease: 'power1.in',
          duration: 0.5,
        },
        0
      );
    }

    return () => {
      ScrollTrigger.getAll().forEach((trigger) => {
        if (trigger.vars.trigger === document.body) {
          trigger.kill();
        }
      });
    };
  }, []);

  // WOW effects: Animate blocks appearing with delay (parallax removed to prevent spreading)
  useEffect(() => {
    if (loading) return;

    const blocks = document.querySelectorAll('.personal-hero-block');
    const hoverHandlers: Array<{
      element: Element;
      enter: () => void;
      leave: () => void;
    }> = [];
    const animations: gsap.core.Tween[] = [];

    blocks.forEach((block, index) => {
      // Initial animation with stagger
      const initialAnim = gsap.fromTo(
        block,
        {
          opacity: 0,
          y: 80,
          scale: 0.85,
          rotationX: -20,
          filter: 'blur(10px)',
        },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          rotationX: 0,
          filter: 'blur(0px)',
          duration: 1.2,
          delay: index * 0.2,
          ease: 'power4.out',
        }
      );
      animations.push(initialAnim);

      // Removed parallax effect that was causing blocks to spread out on scroll
      // Blocks now stay in their fixed positions to prevent layout shifts

      // Hover glow effect
      const handleMouseEnter = () => {
        gsap.to(block, {
          scale: 1.02,
          duration: 0.3,
          ease: 'power2.out',
        });
      };

      const handleMouseLeave = () => {
        gsap.to(block, {
          scale: 1,
          duration: 0.3,
          ease: 'power2.out',
        });
      };

      block.addEventListener('mouseenter', handleMouseEnter);
      block.addEventListener('mouseleave', handleMouseLeave);

      hoverHandlers.push({
        element: block,
        enter: handleMouseEnter,
        leave: handleMouseLeave,
      });
    });

    // Special animation for matrix block (last one)
    const matrixBlock = blocks[blocks.length - 1];
    let matrixAnim: gsap.core.Tween | null = null;
    if (matrixBlock) {
      matrixAnim = gsap.fromTo(
        matrixBlock,
        {
          opacity: 0,
          y: 100,
          scale: 0.8,
        },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 1.5,
          delay: blocks.length * 0.2,
          ease: 'elastic.out(1, 0.5)',
        }
      );
      animations.push(matrixAnim);
    }

    // Cleanup function
    return () => {
      // Kill all animations
      animations.forEach((anim) => {
        if (anim) anim.kill();
      });

      // Remove event listeners
      hoverHandlers.forEach(({ element, enter, leave }) => {
        element.removeEventListener('mouseenter', enter);
        element.removeEventListener('mouseleave', leave);
      });
    };
  }, [loading]);

  const handleFillBirthData = () => {
    router.push('/profile');
  };

  const handleUpgrade = () => {
    router.push('/subscription');
  };

  return (
    <section
      className="personal-hero-root relative w-full h-auto min-h-full max-w-full overflow-x-hidden"
      data-hero-density={density}
      style={{ opacity: 1, pointerEvents: 'auto', minWidth: 0 }}
    >
      {/* Background Tunnel Effect */}
      <div
        className="personal-hero-bg hero-bg-wrapper absolute inset-0 w-full h-full"
        style={{
          position: 'absolute',
          top: 0,
          left: 0,
          width: '100%',
          height: '100%',
          maxWidth: '100%',
          maxHeight: '100%',
          zIndex: 0,
          overflow: 'hidden',
        }}
      >
        <img
          src="/backweb.png"
          alt="Background"
          className="hero-bg-img desktop-only"
          style={{
            transition: 'transform 0.1s ease-out',
            width: '100%',
            height: '100%',
            maxWidth: '100%',
            maxHeight: '100%',
            objectFit: 'cover',
            position: 'absolute',
            top: '50%',
            left: '50%',
            transform: `translate(calc(-50% + ${mousePosition.x}px), calc(-50% + ${mousePosition.y}px)) scale(1.15)`,
          }}
        />
        <img
          src="/backmobile.png"
          alt="Background"
          className="hero-bg-img mobile-only"
          style={{
            transition: 'transform 0.1s ease-out',
            width: '100%',
            height: '100%',
            maxWidth: '100%',
            maxHeight: '100%',
            objectFit: 'cover',
            position: 'absolute',
            top: '50%',
            left: '50%',
            transform: `translate(calc(-50% + ${mousePosition.x}px), calc(-50% + ${mousePosition.y}px)) scale(1.15)`,
          }}
        />
      </div>

      {/* Dark Overlay */}
      <div
        className="personal-hero-overlay hero-overlay absolute inset-0"
        style={{
          zIndex: 1,
          position: 'absolute',
          top: 0,
          left: 0,
          width: '100%',
          height: '100%',
          maxWidth: '100%',
          maxHeight: '100%',
          background:
            'radial-gradient(circle at center, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.8) 50%, rgba(0,0,0,0.95) 100%)',
          pointerEvents: 'none',
        }}
      />

      {/* 3D Stars Background */}
      <div className="absolute inset-0 overflow-hidden" style={{ zIndex: 1 }}>
        {Array.from({ length: 50 }).map((_, i) => {
          const size = Math.random() * 2 + 1;
          const x = Math.random() * 100;
          const y = Math.random() * 100;
          const delay = Math.random() * 3;
          const duration = 3 + Math.random() * 2;

          return (
            <div
              key={i}
              className="absolute rounded-full bg-white star-twinkle"
              style={{
                width: `${size}px`,
                height: `${size}px`,
                left: `${x}%`,
                top: `${y}%`,
                opacity: 0.3 + Math.random() * 0.7,
                animation: `twinkle ${duration}s ease-in-out infinite`,
                animationDelay: `${delay}s`,
                boxShadow: `0 0 ${size * 2}px rgba(255, 255, 255, 0.8)`,
              }}
            />
          );
        })}
      </div>

      <style
        dangerouslySetInnerHTML={{
          __html: `
        @keyframes twinkle {
          0%, 100% {
            opacity: 0.3;
            transform: scale(1);
          }
          50% {
            opacity: 1;
            transform: scale(1.2);
          }
        }
      `,
        }}
      />

      {/* Content */}
      <div className="relative z-10 w-full h-auto min-h-full max-w-full overflow-x-hidden">
        <div className="personal-hero-shell w-full h-auto min-h-full max-w-[1920px] 2xl:max-w-[2200px] mx-auto px-1 sm:px-2 md:px-3 lg:px-4 xl:px-6 2xl:px-8 py-2 sm:py-3 md:py-4 min-w-0">
          <div
            className="personal-hero-layout w-full h-auto min-h-full flex flex-col gap-2 sm:gap-3 md:gap-4 lg:gap-5 min-w-0"
            style={{ position: 'relative', willChange: 'auto' }}
          >
            {/* Top Row: User Name + Lunar Phase + Ratings Full Width */}
            <TopHeaderBlock
              user={user}
              horoscope={horoscopes.daily}
              ratingsLoading={ratingsLoading}
              isPremium={isPremium}
              density={density}
            />

            {/* Bottom Row: 3 Columns - Equal Size */}
            <div
              className="personal-hero-bottom grid flex-1 items-stretch grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-3 md:gap-3 lg:gap-4 xl:gap-5 2xl:gap-6 w-full max-w-full min-w-0 min-h-0"
              style={{ position: 'relative', willChange: 'auto' }}
            >
              {/* Left: Natal Chart */}
              <div
                className="flex flex-col personal-hero-block min-w-0 h-full"
                style={{ position: 'relative', transform: 'translateZ(0)' }}
              >
                {isPremium ? (
                  <NatalChartBlock
                    natalChart={natalChart}
                    user={user}
                    loading={loading}
                    density={density}
                    onViewFull={() =>
                      router.push(
                        natalChart
                          ? '/natal-chart'
                          : hasBirthData
                          ? '/services/natal'
                          : '/profile'
                      )
                    }
                  />
                ) : (
                  <LockedNatalChartBlock
                    hasData={hasBirthData}
                    tier={user.subscriptionTier}
                    onFillData={handleFillBirthData}
                    onUpgrade={handleUpgrade}
                  />
                )}
              </div>

              {/* Center: Destiny Matrix */}
              <div
                className="flex flex-col personal-hero-block min-w-0 h-full"
                style={{ position: 'relative', transform: 'translateZ(0)' }}
              >
                {user.birthDate ? (
                  <DestinyMatrixBlock
                    matrix={destinyMatrix}
                    loading={matrixLoading}
                    onViewDetails={() => router.push('/destiny-matrix')}
                    fullWidth={false}
                    density={density}
                  />
                ) : (
                  <div className="hero-card mira-card mira-card-hover p-5 text-center h-full flex flex-col items-center justify-center">
                    <div className="text-3xl mb-2 opacity-50">💫</div>
                    <h3 className="hero-title-main mira-card-title mb-2">Матрица судьбы</h3>
                    <p className="hero-body text-silver/70 text-sm mb-3 tracking-wide">
                      Заполните дату рождения
                    </p>
                    <button
                      onClick={handleFillBirthData}
                      className="mira-button w-full sm:max-w-[260px] text-sm"
                    >
                      Заполнить данные
                    </button>
                  </div>
                )}
              </div>

              {/* Right: Horoscope */}
              <div
                className="flex flex-col personal-hero-block min-w-0 h-full"
                style={{ position: 'relative', transform: 'translateZ(0)' }}
              >
                {zodiacSign ? (
                  <CompactHoroscopeBlock
                    horoscopes={horoscopes}
                    loading={loading}
                    density={density}
                    onViewFull={(period) =>
                      router.push(
                        `/services/horoscope?sign=${zodiacSign}&period=${period}`
                      )
                    }
                    tier={user.subscriptionTier}
                    luckyNumbers={horoscopes.daily?.luckyNumbers || undefined}
                    luckyColors={horoscopes.daily?.luckyColors || undefined}
                  />
                ) : (
                  <LockedHoroscopeBlock onFillData={handleFillBirthData} />
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
};

// Helper function to get element from sign
const getElementFromSign = (sign: string): string => {
  const idx = signToNum(sign);
  if ([0, 4, 8].includes(idx)) return 'fire';
  if ([1, 5, 9].includes(idx)) return 'earth';
  if ([2, 6, 10].includes(idx)) return 'air';
  if ([3, 7, 11].includes(idx)) return 'water';
  return 'unknown';
};

// Helper function to calculate element distribution
const calculateElements = (planets: NatalChart['planets']) => {
  const elements = { fire: 0, earth: 0, air: 0, water: 0 };
  Object.values(planets).forEach((planet) => {
    const element = getElementFromSign(planet.sign);
    if (element !== 'unknown') {
      elements[element as keyof typeof elements]++;
    }
  });
  const total = Object.values(elements).reduce((a, b) => a + b, 0);
  return {
    fire: total > 0 ? Math.round((elements.fire / total) * 100) : 0,
    earth: total > 0 ? Math.round((elements.earth / total) * 100) : 0,
    air: total > 0 ? Math.round((elements.air / total) * 100) : 0,
    water: total > 0 ? Math.round((elements.water / total) * 100) : 0,
  };
};

// Helper function to calculate modality distribution (Cardinal, Fixed, Mutable)
const calculateModalities = (planets: NatalChart['planets']) => {
  const modalities = { cardinal: 0, fixed: 0, mutable: 0 };
  Object.values(planets).forEach((planet) => {
    const idx = signToNum(planet.sign);
    // Cardinal: Aries (0), Cancer (3), Libra (6), Capricorn (9)
    if ([0, 3, 6, 9].includes(idx)) modalities.cardinal++;
    // Fixed: Taurus (1), Leo (4), Scorpio (7), Aquarius (10)
    else if ([1, 4, 7, 10].includes(idx)) modalities.fixed++;
    // Mutable: Gemini (2), Virgo (5), Sagittarius (8), Pisces (11)
    else if ([2, 5, 8, 11].includes(idx)) modalities.mutable++;
  });
  const total = Object.values(modalities).reduce((a, b) => a + b, 0);
  return {
    cardinal: total > 0 ? Math.round((modalities.cardinal / total) * 100) : 0,
    fixed: total > 0 ? Math.round((modalities.fixed / total) * 100) : 0,
    mutable: total > 0 ? Math.round((modalities.mutable / total) * 100) : 0,
  };
};

// Helper function to get ascendant ruler
const getAscendantRuler = (ascendantSign: string, planets: NatalChart['planets']): { planet: string; label: string } | null => {
  const signIdx = signToNum(ascendantSign);
  // Rulership: Aries→Mars, Taurus→Venus, Gemini→Mercury, Cancer→Moon, Leo→Sun, Virgo→Mercury
  // Libra→Venus, Scorpio→Mars/Pluto, Sagittarius→Jupiter, Capricorn→Saturn, Aquarius→Uranus/Saturn, Pisces→Neptune/Jupiter
  const rulers: Record<number, string[]> = {
    0: ['mars'], // Aries
    1: ['venus'], // Taurus
    2: ['mercury'], // Gemini
    3: ['moon'], // Cancer
    4: ['sun'], // Leo
    5: ['mercury'], // Virgo
    6: ['venus'], // Libra
    7: ['mars', 'pluto'], // Scorpio
    8: ['jupiter'], // Sagittarius
    9: ['saturn'], // Capricorn
    10: ['uranus', 'saturn'], // Aquarius
    11: ['neptune', 'jupiter'], // Pisces
  };
  const planetNames = rulers[signIdx] || [];
  const ruNames: Record<string, string> = {
    sun: 'Солнце', moon: 'Луна', mercury: 'Меркурий', venus: 'Венера', mars: 'Марс',
    jupiter: 'Юпитер', saturn: 'Сатурн', uranus: 'Уран', neptune: 'Нептун', pluto: 'Плутон',
  };
  for (const p of planetNames) {
    if (planets[p]) {
      return { planet: p, label: ruNames[p] || p };
    }
  }
  return null;
};

// Helper function to get retrograde planets
const getRetrogradePlanets = (planets: NatalChart['planets']): string[] => {
  const retrograde: string[] = [];
  Object.entries(planets).forEach(([name, planet]) => {
    if (planet.retrograde) {
      retrograde.push(name);
    }
  });
  return retrograde;
};

// Helper function to get dominant planet (most planets in same sign)
const getDominantPlanet = (
  planets: NatalChart['planets']
): { planet: string; signIndex: number } | null => {
  const signCounts: Record<number, { count: number; planets: string[] }> = {};
  Object.entries(planets).forEach(([name, planet]) => {
    const idx = signToNum(planet.sign);
    if (!signCounts[idx]) {
      signCounts[idx] = { count: 0, planets: [] };
    }
    signCounts[idx].count++;
    signCounts[idx].planets.push(name);
  });

  let maxCount = 0;
  let dominant: { planet: string; signIndex: number } | null = null;
  Object.entries(signCounts).forEach(([idxStr, data]) => {
    if (data.count > maxCount) {
      maxCount = data.count;
      dominant = {
        planet: data.planets[0],
        signIndex: Number(idxStr),
      };
    }
  });

  return dominant;
};

// Zodiac sign to index (0–11) for wheel position
const signToNum = (sign: string): number => {
  const raw = (sign || '').trim().toLowerCase();
  if (!raw) return 0;

  const full = [
    'aries',
    'taurus',
    'gemini',
    'cancer',
    'leo',
    'virgo',
    'libra',
    'scorpio',
    'sagittarius',
    'capricorn',
    'aquarius',
    'pisces',
  ];
  const idxFull = full.indexOf(raw);
  if (idxFull >= 0) return idxFull;

  const three = raw.slice(0, 3);
  const abbr: Record<string, number> = {
    ari: 0,
    tau: 1,
    gem: 2,
    can: 3,
    leo: 4,
    vir: 5,
    lib: 6,
    sco: 7,
    sag: 8,
    cap: 9,
    aqu: 10,
    pis: 11,
  };
  return abbr[three] ?? 0;
};

// Convert sign + degree to absolute degree (0–360), then to SVG x,y (0° Aries = 9 o'clock)
const degreeInSignToXY = (
  sign: string,
  degree: number,
  cx: number,
  cy: number,
  r: number
): { x: number; y: number } => {
  const absoluteDegree = signToNum(sign) * 30 + (degree ?? 0);
  const angleRad = ((180 - absoluteDegree) * Math.PI) / 180;
  return {
    x: cx + r * Math.cos(angleRad),
    y: cy + r * Math.sin(angleRad),
  };
};

// Planet emoji map
const PLANET_EMOJI: Record<string, string> = {
  sun: '☀️',
  moon: '🌙',
  mercury: '☿️',
  venus: '♀️',
  mars: '♂️',
  jupiter: '♃',
  saturn: '♄',
  uranus: '♅',
  neptune: '♆',
  pluto: '♇',
};

// Natal Chart Block Component
const NatalChartBlock: React.FC<{
  natalChart: NatalChart | null;
  user: User;
  loading: boolean;
  density: HeroDensity;
  onViewFull: () => void;
}> = ({ natalChart, user, loading, density, onViewFull }) => {
  const isCompact = density === 'compact';
  const isUltra = density === 'ultra';

  if (loading) {
    return (
      <div className="hero-card mira-card p-6">
        <div className="animate-pulse space-y-4">
          <div className="h-6 bg-white/10 rounded w-1/2" />
          <div className="h-32 bg-white/10 rounded" />
        </div>
      </div>
    );
  }

  if (!natalChart) {
    const missingBirthData = !user.birthTime || !user.birthLocation;
    return (
      <div className="hero-card mira-card mira-card-hover p-5 h-full flex flex-col items-center justify-center text-center">
        <div className="text-4xl mb-3 opacity-50">⭐</div>
        <h3 className="hero-title-main mira-card-title mb-2">Натальная карта</h3>
        <p className="hero-body text-silver/70 text-sm mb-3 tracking-wide">
          {missingBirthData
            ? 'Заполните время и место рождения, чтобы построить круг.'
            : 'Карта ещё не рассчитана'}
        </p>
        <button
          onClick={onViewFull}
          className="mira-button max-w-[260px] text-sm"
        >
          {missingBirthData
            ? 'Заполнить данные →'
            : 'Рассчитать натальную карту →'}
        </button>
      </div>
    );
  }

  const sun = natalChart.planets.sun;
  const moon = natalChart.planets.moon;
  const ascendant = natalChart.houses?.[0];
  const elements = calculateElements(natalChart.planets);
  const modalities = calculateModalities(natalChart.planets);
  const retrogradePlanets = getRetrogradePlanets(natalChart.planets);
  const dominant = getDominantPlanet(natalChart.planets);
  const ascendantRuler = ascendant ? getAscendantRuler(ascendant.sign, natalChart.planets) : null;

  // Все планеты для отображения
  const allPlanets = [
    { name: 'sun', planet: sun, label: 'Солнце' },
    { name: 'moon', planet: moon, label: 'Луна' },
    { name: 'mercury', planet: natalChart.planets.mercury, label: 'Меркурий' },
    { name: 'venus', planet: natalChart.planets.venus, label: 'Венера' },
    { name: 'mars', planet: natalChart.planets.mars, label: 'Марс' },
    { name: 'jupiter', planet: natalChart.planets.jupiter, label: 'Юпитер' },
    { name: 'saturn', planet: natalChart.planets.saturn, label: 'Сатурн' },
    { name: 'uranus', planet: natalChart.planets.uranus, label: 'Уран' },
    { name: 'neptune', planet: natalChart.planets.neptune, label: 'Нептун' },
    { name: 'pluto', planet: natalChart.planets.pluto, label: 'Плутон' },
  ];

  // Основные планеты (для компактного режима)
  const mainPlanets = allPlanets.slice(0, 6);

  return (
    <div className="hero-card hero-panel-card hero-natal-card hero-natal-layout bg-white/5 p-4 sm:p-5 rounded-xl border border-white/10 backdrop-blur-sm h-full flex flex-col">
      <h3 className="text-lg sm:text-xl mb-3 text-white font-bold uppercase tracking-wider flex items-center gap-2">
        <span className="text-mirastros-gold">⭐</span> Натальная карта
