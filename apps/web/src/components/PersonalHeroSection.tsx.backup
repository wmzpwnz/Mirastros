                          mars: 'Марс',
                          jupiter: 'Юпитер',
                          saturn: 'Сатурн',
                          uranus: 'Уран',
                          neptune: 'Нептун',
                          pluto: 'Плутон',
                        };
                        return ruNames[p] || p;
                      })
                      .join(', ')}
