                              day: 'numeric',
                              month: 'short',
                            })}
                          </p>
                          {(() => {
                            const days = getDaysUntil(lunarData.next_full_moon);
                            return !isUltra && days > 0 ? (
                              <p className="text-mirastros-gold text-xs font-bold mt-0.5">
                                {isCompact ? `${days} дн.` : `через ${days} дн.`}
                              </p>
                            ) : null;
                          })()}
                        </div>
                      </div>
                    )}
                    {lunarData.next_new_moon && (
                      <div className="flex items-start gap-2">
                        <span className="text-lg flex-shrink-0">🌑</span>
                        <div className="flex-1 min-w-0">
                          <p className="text-white text-sm font-medium tracking-wide">
                            Новолуние
                          </p>
                          <p className="text-white text-xs tracking-wide">
                            {new Date(
                              lunarData.next_new_moon
                            ).toLocaleDateString('ru-RU', {
                              day: 'numeric',
                              month: 'short',
                            })}
                          </p>
                          {(() => {
                            const days = getDaysUntil(lunarData.next_new_moon);
                            return !isUltra && days > 0 ? (
                              <p className="text-mirastros-gold text-xs font-bold mt-0.5">
                                {isCompact ? `${days} дн.` : `через ${days} дн.`}
                              </p>
                            ) : null;
                          })()}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          </div>

          {/* 2) User */}
          <div className="hero-card hero-top-user flex items-start gap-4 h-full p-4 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm min-w-0">
            <div
