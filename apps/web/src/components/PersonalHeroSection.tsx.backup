              )}

              {/* Доминанта - 25% */}
              {dominant && (
                <div className="hero-natal-insight hero-natal-dominant bg-white/5 p-3 rounded-xl border border-white/10 backdrop-blur-sm flex-[0_0_25%] flex flex-col min-h-[80px]">
