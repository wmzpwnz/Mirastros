{
  "name": "vk-mini",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vk-mini/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/vk-mini"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/vk-mini"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "vk-mini:build",
        "dev": true,
        "port": 3003
      },
      "configurations": {
        "development": {
          "buildTarget": "vk-mini:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "vk-mini:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "vk-mini:build:production"
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/vk-mini/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": ["type:app", "platform:vk"]
}
