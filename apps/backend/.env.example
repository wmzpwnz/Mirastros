# App Configuration
APP_NAME=Mirastros API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://mirastros:mirastros@localhost:5432/mirastros

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# AI Model (update path when model is downloaded)
MODEL_PATH=/home/mirastros/models/qwen2.5-7b-instruct.gguf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:4200"]
RATE_LIMIT_PER_MINUTE=60

# JWT (required; generate a stable secret, e.g. `openssl rand -hex 32`)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin (optional - comma-separated emails)
ADMIN_EMAILS=admin@mirastros.com

# AI - DeepSeek (optional; if empty, AI features disabled)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-flash

# Social Auth (optional; provider endpoints return 501 until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=

# Payment Gateways
# YooKassa (ЮKassa) for Russian market - Get credentials from https://yookassa.ru
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Stripe for international market - Get credentials from https://stripe.com
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Monitoring
# Sentry DSN - Get from https://sentry.io
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
ENVIRONMENT=development

# External Analytics (Optional)
# Mixpanel - Get token from https://mixpanel.com
MIXPANEL_TOKEN=your_mixpanel_token

# Amplitude - Get API key from https://amplitude.com
AMPLITUDE_API_KEY=your_amplitude_api_key

# Contextual result explanations. Defaults keep old open-ended AI routes disabled.
AI_RESULT_EXPLANATIONS_ONLY=true
LEGACY_AI_CHAT_ENABLED=false
# Maximum provider attempts per user per UTC day, including failed attempts.
AI_EXPLANATION_DAILY_LIMIT=5
# Trial generation credits per account. Leave zero until the owner chooses a policy.
AI_EXPLANATION_TRIAL_CREDITS=0

# Included first welcome portrait; no open chat. Cached per calculated profile.
WELCOME_AI_ENABLED=true
WELCOME_AI_MAX_ATTEMPTS=3
WELCOME_AI_DAILY_LIMIT=100
